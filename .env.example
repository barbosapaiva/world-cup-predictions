# Application settings
APP_NAME=World Cup Predictions API
APP_VERSION=1.0.0
DEBUG=True

# PostgreSQL
POSTGRES_USER=worldcup
POSTGRES_PASSWORD=worldcup_secret
POSTGRES_DB=worldcup_predictions
POSTGRES_PORT=5432
POSTGRES_HOST=db

# JWT settings
JWT_SECRET_KEY=your_jwt_secret_key_here 
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Football Data API settings
FOOTBALL_DATA_API_TOKEN=your_token_here
FOOTBALL_DATA_API_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_COMPETITION=WC

# CORS settings
CORS_ORIGINS=http://localhost:3000