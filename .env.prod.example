# Application settings
APP_NAME=World Cup Predictions API
APP_VERSION=1.0.0
DEBUG=False

# PostgreSQL
POSTGRES_USER=worldcup
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=worldcup_predictions
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONTAINER=worldcup-db

# JWT settings - generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Football Data API
FOOTBALL_DATA_API_TOKEN=your_token_here
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_COMPETITION=WC

# CORS
CORS_ORIGINS=https://your-domain.com

# Domain
DOMAIN=your-domain.com